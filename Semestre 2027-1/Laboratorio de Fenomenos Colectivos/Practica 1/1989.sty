\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{1989}
\RequirePackage{titlesec}
\RequirePackage{xcolor}

\definecolor{pumadorado}{RGB}{218,165,32} % Definiendo color dorado
\definecolor{pumaazul}{RGB}{0,51,102} % Definiendo color azul


\titleformat{\section}[hang]
{\Large\bfseries}
{\thesection\enskip\color{pumadorado}\textbar\rule{0.1cm}{0pt}}
{0.3cm}
{}

\titleformat{\subsection}[hang]
{\large\bfseries\color{gray}}
{\thesubsection\enskip\color{magenta}\textbar\rule{0.1cm}{0pt}}
{0.25cm}
{}

\titleformat{\subsubsection}[hang]
{\normalsize\bfseries\color{pumaazul}}
{\thesubsubsection\enskip\color{pumadorado}\textbar\rule{0.1cm}{0pt}}
{0.25cm}
{}


\titlespacing*{\section}{0pc}{2.5ex \@plus4pt \@minus3pt}{5pt}
\titlespacing*{\subsection}{0pc}{2ex \@plus3pt \@minus2pt}{3pt}
\titlespacing*{\subsubsection}{0pc}{1.5ex \@plus2.5pt \@minus1.5pt}{2pt}